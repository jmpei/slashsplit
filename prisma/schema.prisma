// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Auth tables in the shape Better Auth expects (#3). Ids are strings Better Auth generates.
model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  paidExpenses  Expense[]         @relation("ExpensePayer")
  itemParts     ItemParticipant[]
  expenseWeights ExpenseWeight[]
  expenseShares ExpenseShare[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// One row per sign-in method: Google, or the hashed test-login password.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// A shared household (#4). Members join with the invite code.
model Household {
  id          String       @id @default(cuid())
  name        String
  inviteCode  String       @unique
  createdAt   DateTime     @default(now())
  memberships Membership[]
  expenses    Expense[]
}

enum Role {
  OWNER
  MEMBER
}

// joinedAt orders members; split rounding hands leftover cents out in this order (PLAN §5.1).
model Membership {
  userId      String
  householdId String
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@id([userId, householdId])
  @@index([householdId])
}

enum SplitMode {
  EQUAL
  RATIO
  ITEMIZED
}

enum ExpenseStatus {
  DRAFT
  CONFIRMED
}

// An expense in a household (#6). All money fields are integer cents; date is YYYY-MM-DD.
model Expense {
  id          String          @id @default(cuid())
  householdId String
  payerId     String
  merchant    String
  date        String
  totalCents  Int
  splitMode   SplitMode       @default(ITEMIZED)
  status      ExpenseStatus   @default(CONFIRMED)
  receiptUrl  String?
  createdAt   DateTime        @default(now())
  household   Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payer       User            @relation("ExpensePayer", fields: [payerId], references: [id], onDelete: Cascade)
  items       ExpenseItem[]
  taxes       ExpenseTax[]
  weights     ExpenseWeight[]
  shares      ExpenseShare[]

  @@index([householdId])
}

model ExpenseItem {
  id           String            @id @default(cuid())
  expenseId    String
  name         String
  priceCents   Int
  taxCodes     String[]
  sortOrder    Int               @default(0)
  expense      Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  participants ItemParticipant[]

  @@index([expenseId])
}

model ItemParticipant {
  itemId String
  userId String
  item   ExpenseItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([itemId, userId])
}

model ExpenseTax {
  id          String  @id @default(cuid())
  expenseId   String
  code        String
  amountCents Int
  sortOrder   Int     @default(0)
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
}

model ExpenseWeight {
  expenseId String
  userId    String
  weight    Int
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
}

model ExpenseShare {
  expenseId   String
  userId      String
  amountCents Int
  expense     Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([expenseId, userId])
}
