# Copy to .env and fill in. Never commit .env.

# Database (local: docker compose up -d)
DATABASE_URL="postgresql://slashsplit:slashsplit@localhost:5432/slashsplit"
# Direct (non-pooled) URL for migrations. Leave empty locally; set in Vercel production (Neon).
DIRECT_URL=""
TEST_DATABASE_URL="postgresql://slashsplit:slashsplit@localhost:5432/slashsplit_test"

# Auth (Better Auth). Secret: `openssl rand -base64 32`. Google: OAuth client in Google Cloud,
# redirect URI <BETTER_AUTH_URL>/api/auth/callback/google. Without it, only the test login shows.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Receipt scanning (Gemini)
GEMINI_API_KEY=""
# fixture:<name> returns tests/fixtures/receipts/<name>.json instead of calling Gemini.
# Ignored in production (VERCEL_ENV=production, or NODE_ENV=production without VERCEL_ENV).
RECEIPT_EXTRACTOR=""

# Real-time (Pusher)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# E2E against a deployed preview (leave empty to test localhost)
E2E_BASE_URL=""
VERCEL_AUTOMATION_BYPASS_SECRET=""
