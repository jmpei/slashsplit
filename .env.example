# Receipt scanning (Gemini)
GEMINI_API_KEY=""

# Real-time (Pusher)
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""

# Receipt images (Vercel Blob)
BLOB_READ_WRITE_TOKEN=""

# Monthly rent cron
CRON_SECRET=""

# E2E against a deployed preview (leave empty to test localhost)
